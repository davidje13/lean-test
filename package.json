{
	"name": "lean-test",
	"version": "3.0.0",
	"description": "a tiny, extensible test runner",
	"private": true,
	"bin": "./cli.mjs",
	"main": "index.mjs",
	"types": "index.d.ts",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"default": "./index.mjs"
		},
		"./matchers": {
			"types": "./matchers.d.ts",
			"default": "./matchers.mjs"
		}
	},
	"scripts": {
		"format": "prettier --write .",
		"test": "./src/cli/index.mjs src && rollup --config rollup.config.mjs && ./test/run-integration.mjs && ./test/run-package.sh",
		"dopublish": "./tools/build.sh && npm publish package.tgz"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/davidje13/lean-test.git"
	},
	"keywords": [
		"test",
		"unit-test"
	],
	"author": "David Evans",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/davidje13/lean-test/issues"
	},
	"homepage": "https://github.com/davidje13/lean-test#readme",
	"devDependencies": {
		"@rollup/plugin-typescript": "12.x",
		"@types/node": "22.x",
		"prettier": "3.5.3",
		"rollup": "4.x",
		"typescript": "5.8.x"
	}
}
